# ARM64 titanarum worker for the blastbox AWS aws-ec2 (disposable) tier.
#
# blastbox.worker.http_agent = network sibling of .worker.cold: GET /healthz ->
# {"ok":true,"engine":"titanarum"}, POST /detonate?name=<fn> (raw PDF bytes) ->
# the sealed out-dir as application/x-tar. Same load_engine(BLASTBOX_ENGINE) +
# run_detonation core as the cold worker; the JVM/ZXing are the same as on-prem.
#
# Build NATIVELY on an arm64 host (an aarch64 EC2 instance) — no QEMU — or with
# `docker buildx --platform linux/arm64`. The fat jar is arch-independent bytecode;
# only ZXingReader is arch-specific and is compiled from source here for arm64.
# MVP: no AOT cache (this is a disposable one-job worker; _java_worker_argv skips
# -XX:AOTCache when the file is absent).

# ---- jar build (arm64) ----
FROM eclipse-temurin:25-jdk-noble AS jarbuild
WORKDIR /build
COPY pom.xml .
COPY src ./src
RUN apt-get update && apt-get install -y --no-install-recommends maven \
 && mvn -q -DskipTests package \
 && cp target/pdf-titan-arum-*.jar /pdf-titan-arum.jar

# ---- static arm64 ZXingReader v3.1.0 (the release with -json; distro is 2.2.x) ----
FROM debian:12-slim AS zxingbuild
ARG ZXING_TAG=v3.1.0
RUN apt-get update && apt-get install -y --no-install-recommends git cmake g++ make ca-certificates \
 && git clone --depth 1 --branch ${ZXING_TAG} https://github.com/zxing-cpp/zxing-cpp /zxing \
 && cmake -S /zxing -B /zxing/build -DBUILD_SHARED_LIBS=OFF -DZXING_READERS=ON -DZXING_WRITERS=OFF \
          -DZXING_EXAMPLES=ON -DCMAKE_BUILD_TYPE=Release \
 && cmake --build /zxing/build --target ZXingReader -j"$(nproc)" \
 && cp "$(find /zxing/build -name ZXingReader -type f | head -1)" /ZXingReader \
 && /ZXingReader -version

# ---- runtime (arm64) ----
FROM eclipse-temurin:25-jre-noble
RUN apt-get update && apt-get install -y --no-install-recommends \
      fontconfig fonts-dejavu-core python3-venv \
      libturbojpeg-java libheif1 \
 && rm -rf /var/lib/apt/lists/* \
 && useradd -u 10001 -m worker \
 && python3 -m venv /opt/titanarum
ENV PATH=/opt/titanarum/bin:$PATH
COPY --from=jarbuild  /pdf-titan-arum.jar /app/pdf-titan-arum.jar
# rosetta-squint's JPEG/HEIC decode loads the turbojpeg JNI binding (libturbojpeg-java's
# /usr/share/java/turbojpeg.jar). Place it next to the app jar so the uber-jar's RELATIVE manifest
# Class-Path (turbojpeg.jar) resolves it under `java -jar`; test -f fails the build if it moves.
RUN test -f /usr/share/java/turbojpeg.jar && cp /usr/share/java/turbojpeg.jar /app/turbojpeg.jar
COPY --from=zxingbuild /ZXingReader        /usr/local/bin/ZXingReader
RUN /usr/local/bin/ZXingReader -version    # fail the build on a broken arm64 binary
COPY pyproject.toml README.md /src/titanarum/
COPY titanarum /src/titanarum/titanarum
# blastbox 0.1.20 is the first PyPI release that ships blastbox.worker.http_agent
# (the network worker this image runs) + the AWS worker backends; 0.1.19 lacked
# them. That was the original floor; it is now >=0.1.33, which is the release
# that finally publishes six weeks of unreleased main. The `[host]` extra matches the on-prem host
# image (and pulls cryptography for the mTLS/PKI path); `<0.2` guards against a
# future breaking 0.2.0.
RUN /opt/titanarum/bin/pip install --no-cache-dir "blastbox[host]>=0.1.38,<0.2" \
 && /opt/titanarum/bin/pip install --no-cache-dir /src/titanarum \
 && rm -rf /src \
 && /opt/titanarum/bin/python -c "import blastbox.worker.http_agent, titanarum.engine; print('http_agent ok')"
ENV BLASTBOX_ENGINE=titanarum.engine:TitanArumEngine \
    TITANARUM_WORKER_JAR=/app/pdf-titan-arum.jar \
    TITANARUM_JAVA_LIBRARY_PATH=/app \
    TITANARUM_ZXING_BIN=/usr/local/bin/ZXingReader \
    TITANARUM_SANDBOX=container \
    BLASTBOX_WORKER_AGENT_PORT=8765
EXPOSE 8765
USER 10001:10001
CMD ["python", "-m", "blastbox.worker.http_agent"]
