# titanarum-bb Compose configuration — copy to .env and edit.
# Base stack (postgres, docker-socket-proxy, api, dispatcher) is COLD tier
# only. Two warm-tier sidecar overlays now exist (each requires its own
# `-f docker-compose.<tier>.yml` on the compose command line — see their
# headers): gVisor C/R (docker-compose.gvisor.yml, Task 9) and Firecracker
# guest-RAM snapshot (docker-compose.firecracker.yml, Task 11).
#
# The titanarum-compose wrapper auto-writes DOCKER_GID (and, with
# --firecracker once that overlay exists, KVM_GID); don't set those manually.
#
# IMPORTANT: deploy/docker/.env is PER-HOST and gitignored. Never rsync it to a
# remote host as part of a deploy — overwriting POSTGRES_PASSWORD / TITANARUM_PORT
# / TITANARUM_DATA_DIR with a dev workstation's copy desynchronizes credentials,
# changes the external port, and can break the host-consistent job root.

COMPOSE_PROJECT_NAME=titanarum-bb

# ── Image tag ──────────────────────────────────────────────────────────────
# One tag pinned across the whole stack (postgres/host/worker images). Do NOT
# float :latest/:dev in production — bump this on every rebuild.
TAG=pha2

# ── Postgres (job store + /v1/similar pg_bktree index) ──────────────────────
POSTGRES_DB=titanarum
POSTGRES_USER=titanarum
# REQUIRED — no usable default; compose fails fast if unset. This is a
# PLACEHOLDER, not a real secret: the operator sets a strong unique value on
# the host. Generate one with:
#   openssl rand -base64 32
POSTGRES_PASSWORD=CHANGE_ME

# ── Images ───────────────────────────────────────────────────────────────────
# api/dispatcher image (Dockerfile.titanarum-host).
#   docker build -f deploy/docker/Dockerfile.titanarum-host -t titanarum:${TAG} .
TITANARUM_IMAGE=titanarum:pha2
# Cold WORKER image (Dockerfile.titanarum-cold-worker, FROM pdf-titan-arum-base).
# This is what the dispatcher launches per job.
#   docker build -f deploy/docker/Dockerfile.titanarum-base        -t pdf-titan-arum-base:pha2 .
#   docker build -f deploy/docker/Dockerfile.titanarum-cold-worker -t titanarum-cold-worker:pha2 .
TITANARUM_WORKER_IMAGE=titanarum-cold-worker:pha2

# ── Job root (host-consistent bind path) ─────────────────────────────────────
# The api writes job inputs here; the dispatcher bind-mounts them into workers
# (resolved by the host docker daemon), so it MUST exist at the SAME path on the
# host and in the containers. Owned by UID 10001. Unique path — do not reuse
# redtusk-bb's/clippyshot's job root. Create before first start:
#   sudo mkdir -p "$TITANARUM_DATA_DIR" && sudo chown -R 10001:10001 "$TITANARUM_DATA_DIR"
TITANARUM_DATA_DIR=/home/coz/titanarum-bb-data

# ── API exposure ─────────────────────────────────────────────────────────────
# The app does NOT authenticate — front with a reverse proxy for any exposed
# deploy. Restrict to localhost with TITANARUM_BIND_ADDR=127.0.0.1.
# 8004 is the free/reserved port for titanarum-bb on toolz2 (8003=redtusk-bb,
# 8001=clippyshot). This is the ONLY published port in the stack.
TITANARUM_PORT=8004
TITANARUM_BIND_ADDR=0.0.0.0

# ── Job store / metadata trust gate ──────────────────────────────────────────
# Titanarum inlines per-page OCR ExtractedText, so the metadata envelope can
# run much larger than the blastbox 4 MiB default. MUST be identical on the
# api AND every dispatcher (the trust gate enforces equality).
BLASTBOX_MAX_METADATA=104857600
BLASTBOX_JOB_RETENTION_SECONDS=0
# Per-job tier routing (target_tier pins which dispatcher tier claims a job).
# Needed for the 3-tier (cold/FC/gVisor) parity gate; default ON here.
BLASTBOX_ALLOW_TIER_ROUTING=1
# Opt-in ceiling on QUEUED age before a job is FAILed + its input deleted.
BLASTBOX_MAX_QUEUED_AGE_S=600

# ── Dispatcher / worker runtime ──────────────────────────────────────────────
BLASTBOX_DISPATCH_CONCURRENCY=16
BLASTBOX_WORKER_TIMEOUT_S=300
# The titanarum JVM worker is -Xmx4g; RedTusk's 2g default OOM-kills it at
# boot with no report.json. Do not lower below ~4.5g.
BLASTBOX_WORKER_MEMORY=5g
BLASTBOX_WORKER_CPUS=2
BLASTBOX_WORKER_PIDS_LIMIT=256
BLASTBOX_WORKER_NOFILE=4096
# Empty would auto-detect; pin explicitly to the hardened floor for this host.
BLASTBOX_WORKER_RUNTIME=runsc
BLASTBOX_ALLOW_RUNC=0
BLASTBOX_REQUIRE_SECURE_RUNTIME=1
# BLASTBOX_SECCOMP_JSON_HOST=
# BLASTBOX_APPARMOR_PROFILES=

# ── Engine boundary (BLASTBOX_ENGINE_TITANARUM_*) ────────────────────────────
# MUST be byte-identical on the cold dispatcher AND any warm sidecar
# (dispatcher-fc/dispatcher-gvisor) added in Phase 2.
# Forwardable allowlist (default-deny). Narrow Task-13 set; a superset is
# valid: TITANARUM_DPI,TITANARUM_PAGES,TITANARUM_OCR_SCREENSHOTS,
# TITANARUM_OCR_URL_CROPS,TITANARUM_OCR_LANG,TITANARUM_SKIP_QR,
# TITANARUM_SKIP_IMAGES,TITANARUM_SKIP_PHONES,TITANARUM_STREAM_TABLES,
# TITANARUM_SKIP_TABLES.
BLASTBOX_ENGINE_TITANARUM_PARAM_KEYS=TITANARUM_SKIP_SCREENSHOTS,TITANARUM_SKIP_IMAGES,TITANARUM_DPI,TITANARUM_PAGES,TITANARUM_STREAM_TABLES,TITANARUM_SKIP_TABLES
# Operator defaults (per-job value wins). QR on by default = forensic IOC.
BLASTBOX_ENGINE_TITANARUM_DEFAULT_PARAMS=TITANARUM_SKIP_QR=0
# Unconditional code-exec-vector denylist (cold AND warm) — JVM/CRaC/AI/ZXing
# knobs. TITANARUM_ADD_LINK_ANNOTATIONS / --save-modified-pdf are deliberately
# NOT in PARAM_KEYS either (reserved by omission).
BLASTBOX_ENGINE_TITANARUM_RESERVED_KEYS=TITANARUM_AI_URL,TITANARUM_AI_KEY,TITANARUM_AI_MODEL,TITANARUM_JAVA_BIN,TITANARUM_JAVA_OPTS,TITANARUM_WORKER_JAR,TITANARUM_AOT_CACHE,TITANARUM_JAVA_LIBRARY_PATH,TITANARUM_ZXING_BIN,TITANARUM_ZXING_FORMATS,TITANARUM_CRAC_CHECKPOINT,TITANARUM_CRAC_SCRATCH
# Network policy for the launched worker container (titanarum-plan addition;
# RedTusk has no NETPOLICY key).
BLASTBOX_ENGINE_TITANARUM_NETPOLICY=none

# ── docker-socket-proxy GID (auto-written by titanarum-compose on every up) ──
# DOCKER_GID=110

# ── gVisor C/R warm tier (Task 9; docker-compose.gvisor.yml) ─────────────────
# Sidecar dispatcher-gvisor overlay: `docker compose -f docker-compose.yml
# -f docker-compose.gvisor.yml --project-name titanarum-bb up -d
# --force-recreate dispatcher-gvisor`. Requires the warm OCI rootfs staged at
# ${TITANARUM_GVISOR_DIR}/rootfs (deploy/gvisor/Dockerfile.titanarum, built +
# staged by Task 10's build-rootfs step on toolz2 — NOT done by this repo).
TITANARUM_GVISOR_DIR=/home/coz/titanarum-bb-gvisor
# Aggregate memory ceiling for the whole warm pool (all slots combined, not
# per-slot) — titanarum's JVM is -Xmx4g per slot, size for
# BLASTBOX_GVISOR_WARM_SIZE concurrent slots + headroom.
TITANARUM_GVISOR_MEMORY=24g
# Warm pool size == BLASTBOX_DISPATCH_CONCURRENCY on dispatcher-gvisor (a
# mismatch starves the pool — see docker-compose.gvisor.yml).
BLASTBOX_GVISOR_WARM_SIZE=4
# BLASTBOX_GVISOR_CEILING=4

# ── FC warm tier (Task 11; docker-compose.firecracker.yml) ──────────────────
# Sidecar dispatcher-fc overlay: `docker compose -f docker-compose.yml
# -f docker-compose.firecracker.yml --project-name titanarum-bb up -d
# --force-recreate dispatcher-fc`. Requires the FC assets (firecracker binary
# >= 1.15.1 + a >= 5.18 vmlinux guest kernel + titanarum-rootfs.ext4, built
# from deploy/firecracker/Dockerfile.titanarum via the vendored
# deploy/firecracker/build-rootfs.sh) staged at ${TITANARUM_FC_DIR} — Task 12's
# rootfs build + deploy, NOT done by this repo.
TITANARUM_FC_DIR=/home/coz/titanarum-bb-fc
# /dev/kvm group GID on the host (check with `stat -c %g /dev/kvm`; commonly
# 994 on Debian/Ubuntu). Same knob dispatcher-gvisor's docker socket proxy
# doesn't need — FC is the only tier that opens /dev/kvm directly.
KVM_GID=994
# Warm pool size == BLASTBOX_DISPATCH_CONCURRENCY on dispatcher-fc (a mismatch
# starves the pool — see docker-compose.firecracker.yml).
BLASTBOX_FC_WARM_SIZE=2
# BLASTBOX_FC_CEILING=2
# vcpu_count=1 is blastbox's own vsock-corruption mitigation
# (blastbox.host.runtime.firecracker.FCConfig); do not raise it.
# BLASTBOX_FC_VCPU=1
# The in-VM JVM is -Xmx4g pre-touched + AOT + python overhead — 4608 MiB gives
# headroom above -Xmx4g.
BLASTBOX_FC_MEM_MIB=4608
BLASTBOX_FC_OUTDISK_MIB=1024
