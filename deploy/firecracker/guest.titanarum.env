# Sourced by /init for the titanarum FC rootfs. Selects the non-root DROP_USER
# + guest scratch home. Clone of blastbox's guest.redtusk.env — see
# deploy/firecracker/Dockerfile.titanarum's header for the full FC-tier
# rationale (Finding A: no vsock/native/CPUFeatures on titanarum's side).

# NUMERIC uid, not a name. Unlike RedTusk's host image (which `useradd`s a
# named `redtusk` user), titanarum's cold-worker base image
# (deploy/docker/Dockerfile.titanarum-cold-worker) only sets `USER 10001:10001`
# in the Dockerfile — it never runs `useradd`, so no `titanarum` entry exists
# in /etc/passwd in the exported rootfs. `setpriv --reuid "$DROP_USER"` (in
# /init) accepts either a resolvable name or a numeric uid; a name here would
# fail to resolve at guest boot (init's `exec` would fail -> logged FATAL, but
# still a dead guest). Numeric sidesteps the name/uid mismatch entirely.
DROP_USER=10001
GUEST_HOME=/tmp
export TMPDIR=/tmp

# The in-VM engine (titanarum.engine.TitanArumEngine, loaded by run_guest.py's
# get_engine() via the module:Class seam) Popens
# `java -jar /app/pdf-titan-arum.jar … --run <scratch>` (titanarum/engine.py's
# _java_worker_argv). These values already match engine.py's own defaults
# (_DEFAULT_WORKER_JAR/_DEFAULT_AOT_CACHE/_DEFAULT_JAVA_LIBRARY_PATH); they are
# re-declared because `docker export` drops Docker ENV, and to make the
# in-guest worker config auditable from this one file.
export TITANARUM_WORKER_JAR=/app/pdf-titan-arum.jar
export TITANARUM_AOT_CACHE=/app/titanarum.aot
export TITANARUM_JAVA_LIBRARY_PATH=/app
export TITANARUM_SANDBOX=container
# TitanArumEngine.warmup() already sets this on the JVM's Popen env
# unconditionally, but it's declared here too (ambient guest env, belt-and-
# suspenders / auditable) — it is what makes runWorker's go-wait block
# UNBOUNDED on a monotonic clock (W-1) instead of the legacy 600s cold
# wall-clock deadline, which is required for a snapshot restored long after
# the base VM was booted.
export TITANARUM_WARM=1

# Warm/snapshot tier: the HOST reaps idle slots (pool warm_size/ceiling), so
# the guest must NOT self-retire while it sits warm (snapshotted) waiting for
# a job — and a snapshot-restored guest's clock can skew right after restore,
# which would make a short self-timeout fire early. 24h idle (run_guest.py's
# cold-tier default is 120s).
export BLASTBOX_WARM_IDLE_TIMEOUT_S=86400
